# demo works without LLM, model files or databases; live requires the fields below.
RETRIEVAL_BACKEND=demo
RETRIEVAL_REQUEST_TIMEOUT=90
RETRIEVAL_MAX_WORKERS=1
RETRIEVAL_MAX_PENDING=4
RETRIEVAL_CACHE_TTL=60
RETRIEVAL_CACHE_ENTRIES=128
# Bump after changing indexed documents; cache does not watch external databases.
RETRIEVAL_CORPUS_VERSION=rs12-v1
RETRIEVAL_API_TOKEN=
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ITEM_MODEL=qwen-flash
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks_v2
ITEM_NAME_COLLECTION=kb_item_names_v2
ENTITY_NAME_COLLECTION=kb_entity_names_v2
BGE_M3_PATH=/models/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_LARGE=/models/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Optional external search, disabled by default.
MCP_DASHSCOPE_BASE_URL=
